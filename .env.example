# Vortex node config — copy to .env and fill in.
# Secrets (*_SECRET, POSTGRES_PASSWORD, etc.) auto-generate on first run if blank.

HOST=0.0.0.0
PORT=8000
DEVICE_NAME=MyNode

# local   — LAN only, no internet
# global  — via Cloudflare Tunnel + obfuscation (most common)
# custom  — pass CONTROLLER_URL/CONTROLLER_PUBKEY yourself
NETWORK_MODE=local

# For global/custom mode only:
CONTROLLER_URL=
CONTROLLER_PUBKEY=
NODE_ANNOUNCE_ENDPOINTS=
CONTROLLER_HEARTBEAT_SEC=60

DB_PATH=vortex.db
UPLOAD_DIR=uploads
KEYS_DIR=keys
MAX_FILE_MB=3072

NODE_PUBKEY=
WALLET_PUBKEY=
NODE_INITIALIZED=false

# Program id that holds Config, Subscription, Stake PDAs. Pinned by
# solana_program/deploy.sh — don't edit by hand.
VORTEX_PROGRAM_ID=Vor1exReg1111111111111111111111111111111111

# Solana RPC endpoint. The public mainnet-beta URL aggressively rate-limits
# (HTTP 429) once a node has meaningful traffic — a dedicated RPC is
# strongly recommended in production. Free tiers that work well:
#   - Helius:    https://mainnet.helius-rpc.com/?api-key=<YOUR_KEY>
#   - QuickNode: https://<yours>.solana-mainnet.quiknode.pro/<token>/
#   - Ankr:      https://rpc.ankr.com/solana/<token>
# Leave blank to use the public endpoint (development only).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PREMIUM_CACHE_TTL=300
PREMIUM_RPC_TIMEOUT=4.0

# Treasury wallet (receives register fees + premium revenue). Default is
# the owner of vortexx.sol; override for forks/test deployments.
TREASURY_PUBKEY=5ABkkipTZZEEPNR3cP4MCzftpAhqv6jvM4UTSLPGt5Qq

# Platform-admin dashboard bearer token. Leave empty to disable /admin/*
# entirely (safer default than a guessable default).
ADMIN_TOKEN=

# Disable for testing over Cloudflare Tunnel — the probe detector
# otherwise flags CF edge requests as censorship probes and serves
# them a cover page instead of real content, which Cloudflare then
# returns as 502. Keep enabled in production on real ingress paths.
OBFUSCATION_ENABLED=true

# Vortex requires a working post-quantum KEM library (Kyber-768/ML-KEM).
# Install one of:
#   - pip install liboqs-python  (requires native liboqs — "brew install liboqs" first on macOS)
#   - pip install pqcrypto       (pure fallback, no native deps)
# If neither loads, the app starts in SIMULATION MODE — NOT cryptographically
# secure. Set VORTEX_PQ_SIMULATE=1 explicitly to allow it in development.
VORTEX_PQ_SIMULATE=0
VORTEX_PQ_REQUIRED=false

# Stealth level 4 — protocol and relay secrets. This repository is public, so
# there are no built-in defaults: a static literal would let a censor compute a
# valid marker and confirm the node with an active probe. Leave blank and each
# install generates its own random value into .env on first run; share that
# value with your clients / deployed relays.
SHADOWTLS_PASSWORD=
TROJAN_PASSWORD=
CDN_WORKER_KV_SECRET=
AWS_RELAY_SECRET=
AZURE_RELAY_SECRET=

# NaïveProxy identifiers baked into the generated Caddyfile. Blank = random
# username and a random probe_resistance domain per install.
NAIVE_USERNAME=
NAIVE_PROBE_DOMAIN=

# Azure Storage account name for the Azure CDN relay — yours, no default.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# How often the secrets above are rotated. On each rotation the previous value
# is kept in <KEY>_PREV and stays valid for one more window, so clients and
# already-deployed Workers/Lambdas keep working until you roll out the new one.
# 0 disables rotation. Values set in the process environment (Docker, systemd)
# are treated as operator-managed and never rotated.
SECRET_ROTATION_HOURS=168

# Lets clients pull the current protocol passwords themselves from
# GET /api/transport/level4/secrets (header X-Transport-Token) so they can
# follow a rotation within the grace window. Deliberately blank by default:
# with open registration anyone who signs up would otherwise get the Trojan
# password, which is all a censor needs to confirm the node by active probe.
# Set it only if you hand the token to your own clients out of band.
TRANSPORT_ACCESS_TOKEN=
TRANSPORT_SECRETS_RATE_LIMIT=10

# Automatic relay redeploy after a rotation. Each target is skipped unless all
# of its variables are set, and failures are retried with growing backoff until
# the grace window closes (the old secret still works until then).
#
# Cloudflare Worker. The KV namespace id is mandatory: uploading a script
# without it would drop the Worker's VORTEX_KV binding.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CDN_WORKER_SCRIPT_NAME=vortex-relay
CDN_WORKER_KV_NAMESPACE_ID=
CDN_WORKER_BACKEND_URL=

# AWS Lambda@Edge. It has no environment variables, so the secret lives in the
# code: every rotation publishes a new version and repoints the distribution.
# The function must be in us-east-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LAMBDA_FUNCTION_NAME=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Azure Function — Kudu zip deploy with the app's publishing credentials.
AZURE_FUNCTION_APP=
AZURE_PUBLISH_USER=
AZURE_PUBLISH_PASSWORD=

# NaiveProxy: path to the Caddyfile this node owns. Rewritten and reloaded via
# the Caddy admin API when the NaiveProxy identifiers rotate.
NAIVE_CADDYFILE_PATH=
CADDY_ADMIN_URL=http://127.0.0.1:2019

RELAY_DEPLOY_MAX_BACKOFF=3600
